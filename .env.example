# ── JWT Secret (REQUIRED) ────────────────────────────────────────────────────
# Generate with: python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MCP_JWT_SECRET=change-me-to-a-random-secret

# Token expiry in days (default: 30)
MCP_TOKEN_EXPIRY_DAYS=30

# ── External Service URLs ────────────────────────────────────────────────────
# Only change if self-hosting these services
FDM_BASE_URL=https://datatagger.ub.tum.de

# ── NOMAD MCP (nomad-mcp service) ────────────────────────────────────────────
# The deployment's own read-only NOMAD token. Callers that never register run
# as this token, which is what makes the server autoconnected. Leave it empty
# and those callers see public data only.
NOMAD_MCP_DEFAULT_PAT=
NOMAD_MCP_BASE_URL=http://proxy:80/nomad-oasis/api/v1
NOMAD_MCP_ALLOW_ANONYMOUS=true
NOMAD_MCP_REQUIRE_TOKEN=false
NOMAD_MCP_RATE_LIMIT=120
NOMAD_MCP_MAX_RESPONSE_CHARS=60000
NOMAD_MCP_TIMEOUT_S=60

# ── elabFTW (elabftw + elab-mysql services) ──────────────────────────────────
ELABFTW_DB_PASSWORD=
ELABFTW_MYSQL_ROOT_PASSWORD=
ELABFTW_SECRET_KEY=

# ── Note on the econverse host ───────────────────────────────────────────────
# Caddy imports the chat assistant's host block from ../atlas/caddy, the private
# atlas deployment. That checkout is not part of this repository; without it the
# glob is empty and atlas.e-conversion.de is simply not served.
