# Alles, was jeder everse-Host bedienen soll: die statische Landing-Page unter
# /, die MCP-Proxies unter /el, /dt und /nm und NOMAD - damit auch die SSO-Session -
# unter /nomad-oasis/*. Der Chat-Host (atlas.e-conversion.de) hat einen eigenen
# Block im atlas-Checkout und schickt / direkt in den Chatbot.
(everse_stack) {
	# Kurze Wege zu den TGA-Seiten. Die App liegt hinter /nomad-oasis, weil sie
	# dort die NOMAD-Session erbt (Cookie mit Path=/nomad-oasis); diese Adressen
	# leiten dorthin um. Wichtig: "redir" wird vor "handle"/"handle_path"
	# ausgewertet, sonst schluckt /el* die Adresse /eln.
	redir /requests /nomad-oasis/api/tga-forms/requests permanent
	redir /eln /nomad-oasis/api/tga-forms/eln permanent
	# /eln/<upload_id> ist der Download des ELN-Pakets
	redir /eln/* /nomad-oasis/api/tga-forms{uri} permanent
	redir /admin /nomad-oasis/api/tga-forms/admin permanent
	redir /tga /nomad-oasis/api/tga-forms/ permanent

	@api path /dt/* /el/* /nm/*

	@options method OPTIONS

	handle @options {
		respond 204
	}

	handle_path /nm* {
		uri strip_prefix /nm
		reverse_proxy nomad-mcp:8000 {
			flush_interval -1
		}
	}

	handle_path /dt* {
		uri strip_prefix /dt
		reverse_proxy datatagger-proxy:8000 {
			flush_interval -1
		}
	}

	handle_path /el* {
		uri strip_prefix /el
# The standalone Python server (tum-research-data-hub/elabmcp) replaced
# the R-based proxy on 2026-09-30. elabmcp-proxy stays in the compose
# file for a rollback; its container is stopped.
reverse_proxy elabmcp:8081 {
			flush_interval -1
		}
	}

	# NiceGUI-Assets der TGA-Formular-App (app referenziert /_nicegui/ absolut)
	handle /_nicegui* {
		reverse_proxy proxy:80 {
			flush_interval -1
		}
	}

	handle /nomad-oasis/* {
		reverse_proxy proxy:80 {
			flush_interval -1
		}
	}

	root * /srv/http
	file_server browse

	header @api {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods GET, POST, HEAD, OPTIONS
		Access-Control-Allow-Headers Content-Type, Authorization
		Access-Control-Expose-Headers Content-Type
		Cache-Control no-cache
		Connection keep-alive
		X-Accel-Buffering no
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# Die "Website": Landing-Page unter /, NOMAD + tga-forms unter /nomad-oasis/*.
researchdata.e-conversion.de researchmcp.duckdns.org {
	import everse_stack
}

# The econverse host block is not kept here. It lives in the atlas deployment
# (private GitLab, caddy/econverse.caddy) and is mounted into /etc/caddy/sites
# by the compose file, so there is exactly one copy of it. The glob matches
# nothing when that checkout is absent, which Caddy accepts -- the host is then
# simply not served.
import /etc/caddy/sites/*.caddy
