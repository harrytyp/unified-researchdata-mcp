# Shared nginx config for both HTTP and HTTPS
resolver 127.0.0.11 valid=10s;

gzip_min_length     1000;
gzip_buffers        4 8k;
gzip_http_version   1.0;
gzip_disable        "msie6";
gzip_vary           on;
gzip on;
gzip_proxied any;
gzip_types
    text/css
    text/javascript
    text/xml
    text/plain
    application/javascript
    application/x-javascript
    application/json;

location / {
    proxy_pass http://$nomad_app$request_uri;
}

location ~ /nomad-oasis\/?(gui)?$ {
    rewrite ^ /nomad-oasis/gui/ permanent;
}

location /nomad-oasis/gui/ {
    proxy_intercept_errors on;
    error_page 404 = @redirect_to_index;
    proxy_pass http://$nomad_app$request_uri;
}

location @redirect_to_index {
    rewrite ^ /nomad-oasis/gui/index.html break;
    # $request_uri would still carry the original path, so the rewrite above is
    # lost and the app answers 404 again (the GUI root and every SPA deep link
    # ended in nginx's own 404). $uri is the rewritten one.
    proxy_pass http://$nomad_app$uri$is_args$args;
}

location /nomad-oasis/docs/ {
    # This is added to force a redirect (302) when 404 otherwise
    # the assets are not loaded correctly (a broken page rendered)
    proxy_intercept_errors on;
    error_page 404 = @docs404redirect;
    proxy_pass http://$nomad_app$request_uri;
}

location @docs404redirect {
    return 302 /nomad-oasis/docs/404.html;
}

location ~ \/gui\/(service-worker\.js|meta\.json)$ {
    add_header Last-Modified $date_gmt;
    add_header Cache-Control 'no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0';
    if_modified_since off;
    expires off;
    etag off;
    proxy_pass http://$nomad_app$request_uri;
}

location ~ /api/v1/uploads(/?$|.*/raw|.*/bundle?$)  {
    client_max_body_size 35g;
    proxy_request_buffering off;
    proxy_pass http://$nomad_app$request_uri;
}

location ~ /api/v1/.*/download {
    proxy_buffering off;
    proxy_pass http://$nomad_app$request_uri;
}

location /nomad-oasis/north/ {
    client_max_body_size 500m;
    proxy_pass http://north:9000;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # websocket headers
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Scheme $scheme;

    proxy_buffering off;
}
# ── TGA-Formular (eigene App unter dem NOMAD-Cookie-Pfad) ──────────────────
# Erbt die NOMAD-Session: die GUI setzt das 'Authorization'-Cookie mit
# Path=/nomad-oasis; Requests an /nomad-oasis/tga-forms/* senden es mit.
location = /nomad-oasis/tga-forms {
    return 301 /nomad-oasis/api/tga-forms/;
}


# NiceGUI-Assets der TGA-Formular-App (die App referenziert /_nicegui/ absolut)

# NiceGUI-WebSocket der TGA-Formular-App
location /_nicegui_ws/ {
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_pass http://tga-forms:8090;
}

location /_nicegui/ {
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_pass http://tga-forms:8090;
}

location /nomad-oasis/tga-forms/ {
    return 301 /nomad-oasis/api/tga-forms/;
}

# TGA-Formular unter /nomad-oasis/api/... — NUR dort sendet der Browser das
# Authorization-Cookie (die GUI setzt es mit Path=<apiBase>=/nomad-oasis/api)
location /nomad-oasis/api/tga-forms/ {
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://tga-forms:8090/;
}

# --- Everse-Chatbot hinter NOMAD-SSO (DIT-19) ---
# Wie tga-forms: nur unter /nomad-oasis/api/... sendet der Browser das
# Authorization-Cookie (GUI setzt Path=<apiBase>=/nomad-oasis/api).
# NOMAD selbst genauso: Variable + resolver => Recreate-safe.
set $nomad_app app:8000;
# Keine absoluten Location-Header: nginx sieht intern nur HTTP und
# wuerde http://... erzeugen - der Browser soll auf https bleiben.
absolute_redirect off;

# e-converse ersetzt den Everse-Chatbot und laeuft seit 2026-09-24 direkt auf
# https://econverse.e-conversion.de/ (e-converse/caddy/econverse.caddy); die
# alten Pfade bleiben fuer Lesezeichen und die NOMAD-GUI-Karte als Weiterleitung.
location = /nomad-oasis/everse {
    return 301 https://econverse.e-conversion.de/;
}
location /nomad-oasis/everse/ {
    return 301 https://econverse.e-conversion.de/;
}
location /nomad-oasis/api/everse/ {
    return 301 https://econverse.e-conversion.de/;
}

